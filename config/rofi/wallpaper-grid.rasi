/* wallpaper-grid — thumbnail grid picker, inherits active theme colors */
@import "active-colors.rasi"

* {
    background-color: transparent;
    text-color: @fg;
    font: "sans-serif 10";
}

window {
    background-color: @bg;
    border: 1px;
    border-color: @border-color;
    border-radius: 10px;
    width: 920px;
    padding: 0px;
    location: center;
    anchor: center;
    transparency: "real";
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 0px;
}

inputbar {
    margin: 12px 14px 6px 14px;
    background-color: @bg-selected;
    border-radius: 8px;
    padding: 8px 14px;
    spacing: 10px;
    children: [ prompt, entry, button-carousel ];
}

/* Corner button — hands over to the filmstrip view.
   It completes rofi's kb-custom-1, so rofi exits with status 10 and
   wallpaper-picker.sh then launches wallpaper-carousel. */
button-carousel {
    expand: false;
    content: "⊞ Filmstrip";
    action: "kb-custom-1";
    background-color: @bg;
    text-color: @fg-alt;
    border-radius: 6px;
    padding: 4px 10px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    cursor: pointer;
}

button-carousel selected.normal {
    background-color: @border-color;
    text-color: @bg;
}

prompt {
    text-color: @fg-alt;
    font: "sans-serif 13";
    vertical-align: 0.5;
}

entry {
    placeholder: "Type to filter — Enter applies";
    placeholder-color: @fg-alt;
    text-color: @fg;
    font: "sans-serif 13";
    vertical-align: 0.5;
}

listview {
    background-color: transparent;
    columns: 4;
    lines: 3;
    cycle: true;
    scrollbar: false;
    layout: vertical;
    padding: 8px 10px 10px 10px;
    spacing: 6px;
    fixed-height: true;
    fixed-columns: true;
}

element {
    padding: 4px;
    border-radius: 6px;
    spacing: 2px;
    orientation: vertical;
    children: [ element-icon, element-text ];
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @bg-selected;
    text-color: @fg;
}

element-icon {
    size: 150px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    horizontal-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

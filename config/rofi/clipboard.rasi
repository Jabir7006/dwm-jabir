/*
 * Clipboard history theme for rofi (clipmenu front-end).
 * Inherits the active Spotlight look + warm palette from config.rasi
 * (which @imports active-colors.rasi, regenerated by theme-apply.sh),
 * so this menu re-themes automatically on every theme switch.
 */
@import "config.rasi"

/* Clipboard entries aren't apps — no icon column. */
configuration { show-icons: false; }

window   { width: 700px; }

/* Keep the search field, drop the drun "🔍" prompt. */
inputbar { children: [ entry ]; }
entry    { placeholder: "Search clipboard…"; }

listview { lines: 10; }

/* Text-only rows (no leftover icon spacing). */
element  { children: [ element-text ]; }

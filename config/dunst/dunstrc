# Auto-generated by theme-apply.sh — do not edit manually.
# Change the theme in ~/.config/dwm-titus/themes.toml instead.
#
# Layout / readability tuning — purely static settings, zero runtime cost:
# no animations, no scripts, no recursion. Dunst parses this once at startup.

[global]
    font = "JetBrainsMono Nerd Font Mono Medium 10.5, monospace 10.5"
    origin = top-right
    offset = (14, 38)
    notification_limit = 5
    padding = 14
    horizontal_padding = 16
    frame_width = 2
    corner_radius = 14
    gap_size = 8
    icon_position = left
    icon_corner_radius = 8
    mouse_middle_click = do_action, remove_current
    frame_color = "#72696A"

[urgency_low]
    background = "#2C2525"
    foreground = "#E6D9DB"
    frame_color = "#72696A"

[urgency_normal]
    background = "#2C2525"
    foreground = "#E6D9DB"
    frame_color = "#72696A"

[urgency_critical]
    background = "#2C2525"
    foreground = "#E6D9DB"
    frame_color = "#FD6883"
    timeout = 12

#!/bin/bash

AP_IF="ap0"
AP_IP="10.42.0.1/24"
HOSTAPD_CONF="/etc/hostapd/localsend.conf"
PIDFILE="/run/localsend-dnsmasq.pid"

if pgrep -f "hostapd.*$HOSTAPD_CONF" >/dev/null 2>&1; then
    pkill -f "hostapd.*$HOSTAPD_CONF"
    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")" 2>/dev/null || true
        rm -f "$PIDFILE"
    fi
    echo "LocalSend AP: OFF"
    exit 0
fi

if ! ip link show "$AP_IF" >/dev/null 2>&1; then
    iw dev wlo1 interface add "$AP_IF" type __ap
fi

ip addr add "$AP_IP" dev "$AP_IF" 2>/dev/null || true
ip link set "$AP_IF" up

hostapd "$HOSTAPD_CONF" >/dev/null 2>&1 &
sleep 2

dnsmasq \
    --interface="$AP_IF" \
    --bind-interfaces \
    --dhcp-range=10.42.0.10,10.42.0.100,255.255.255.0,12h \
    --no-resolv \
    --no-hosts \
    --pid-file="$PIDFILE" \
    >/dev/null 2>&1 &

echo "LocalSend AP: ON"

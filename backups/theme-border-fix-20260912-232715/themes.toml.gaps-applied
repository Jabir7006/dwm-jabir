# ╔══════════════════════════════════════════════════════════════════════╗
# ║               DWM Theme Configuration  ·  themes.toml               ║
# ╠══════════════════════════════════════════════════════════════════════╣
# ║  LIVE RELOAD — just save this file and changes apply instantly!      ║
# ║  Manual reload: kill -USR1 $(pidof dwm)                              ║
# ╚══════════════════════════════════════════════════════════════════════╝
#
# HOW TO SWITCH THEME
# ───────────────────
# 1. Change the theme name in [active] below to any theme defined in this file.
# 2. Save the file — DWM, terminal, rofi, and polybar all update instantly!
#
# Available themes:
#   DARK:  nord · dracula · gruvbox · catppuccin · tokyonight · tokyonight-omarchy
#          onedark · macos-dark · solarized · rosepine · everforest · monochrome
#   LIGHT: catppuccin-latte · gruvbox-light · solarized-light · rosepine-dawn · tokyonight-day · macos-light
#   DYNAMIC: theme.dynamic (generated from wallpaper — run theme-set-dynamic; never edit by hand)
#
# BORDER SIZE
# ───────────
#   borderpx = 0   → no borders (minimal look)
#   borderpx = 1   → thin, clean borders (default)
#   borderpx = 2   → thicker borders, easier to see
#   borderpx = 3   → bold borders


# ══════════════════════════════════════════════════════════════════════════════
# ACTIVE THEME  ←  only change this
# ══════════════════════════════════════════════════════════════════════════════

[active]
theme = "tokyonight-omarchy"   # ← change only this line to switch themes

[appearance]
borderpx = 1   # border size in pixels (0 = none, 1-3 = recommended)
gaps = 10      # outer + inner window gap in pixels (0 = no gaps)


# ══════════════════════════════════════════════════════════════════════════════
# THEME DEFINITIONS  —  add or edit themes here
# ══════════════════════════════════════════════════════════════════════════════
#
# Each [theme.name] section defines a complete theme for all apps:
#
#   DWM colors:
#     normfgcolor / normbgcolor / normbordercolor  → unfocused bar & windows
#     selfgcolor  / selbgcolor  / selbordercolor   → focused window & active tag
#
#   Terminal colors:
#     term_bg / term_fg / term_cursor
#     term_color0 … term_color15  (standard 16-color palette)
#
#   Ghostty: ghostty_theme = "BuiltInThemeName"  (or "custom" to use term_* above)
#   Rofi:    rofi_theme    = "filename"           (without .rasi, from rofi/themes/)
#   Dark mode: dark_mode = true                   (true = dark, false = light; default: true)
#   GTK override (optional): gtk_muted = "#..."   (secondary text; defaults to term_color8)
#   GTK override (optional): gtk_bg / gtk_base / gtk_border
#     (dark rule: sidebar = theme bg darkened 25%, body = theme bg,
#      app borders = rofi accent; macos-dark pins its classic values)
#   GTK override (optional): select_bg / select_fg
#     (selected rows; default = accent + dark text)
#   Browser (optional): browser_frame = "#..."      (Chromium frame tint; defaults to polybar_bg)
#   Polybar: polybar_bg / polybar_fg / polybar_bg_alt / polybar_fg_alt / polybar_accent / polybar_urgent


# ── Nord ──────────────────────────────────────────────────────────────────────
[theme.nord]
normfgcolor     = "#D8DEE9"
normbgcolor     = "#434C5E"
normbordercolor = "#3B4252"
selfgcolor      = "#ECEFF4"
selbgcolor      = "#434C5E"
selbordercolor  = "#81A1C1"

term_bg         = "#2E3440"
term_fg         = "#D8DEE9"
term_cursor     = "#81A1C1"
term_color0     = "#3B4252"
term_color1     = "#BF616A"
term_color2     = "#A3BE8C"
term_color3     = "#EBCB8B"
term_color4     = "#81A1C1"
term_color5     = "#B48EAD"
term_color6     = "#88C0D0"
term_color7     = "#E5E9F0"
term_color8     = "#4C566A"
term_color9     = "#BF616A"
term_color10    = "#A3BE8C"
term_color11    = "#EBCB8B"
term_color12    = "#81A1C1"
term_color13    = "#B48EAD"
term_color14    = "#8FBCBB"
term_color15    = "#ECEFF4"

ghostty_theme   = "Nord"
rofi_theme      = "sidetab-nord"
dark_mode       = true
gtk_muted       = "#616E88"   # de-facto Nord comment grey (color8 is unreadable on canvas)

polybar_bg      = "#2e3440"
polybar_fg      = "#d8dee9"
polybar_bg_alt  = "#3b4252"
polybar_fg_alt  = "#4c566a"
polybar_accent  = "#81a1c1"
polybar_urgent  = "#bf616a"



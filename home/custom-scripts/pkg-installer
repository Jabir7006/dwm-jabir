#!/usr/bin/env bash
# Dusky Package Atlas - Production Standard V8 (Relative "Xd ago" + clearer URL open)

export SHELL=/bin/bash

# --- 0. HELPERS ---
_relative_time() {
    # Input: unix timestamp (seconds). Output: human relative string.
    local ts="$1"
    [[ -z "$ts" || ! "$ts" =~ ^[0-9]+$ ]] && { echo "—"; return; }
    local now=$(date +%s)
    local diff=$(( now - ts ))
    (( diff < 0 )) && diff=0
    if   (( diff < 60 ));      then echo "just now"
    elif (( diff < 3600 ));    then echo "$((diff/60))m ago"
    elif (( diff < 86400 ));   then echo "$((diff/3600))h ago"
    elif (( diff < 604800 ));  then echo "$((diff/86400))d ago"
    elif (( diff < 2592000 )); then echo "$((diff/604800))w ago"
    elif (( diff < 31536000 )); then echo "$((diff/2592000))mo ago"
    else echo "$((diff/31536000))y ago"
    fi
}
export -f _relative_time

# Convert a free-form date string (from yay/pacman) to relative "Xd ago"
_date_to_relative() {
    local raw="$1"
    [[ -z "$raw" || "$raw" == "—" || "$raw" == "None" ]] && { echo "—"; return; }

    # Strip common noise and trailing timezone
    local cleaned
    cleaned=$(echo "$raw" | sed -E 's/[[:space:]]+[A-Z]{3,4}$//; s/[[:space:]]+[+-][0-9]{2,4}$//; s/[[:space:]]+UTC$//; s/^[[:space:]]+|[[:space:]]+$//g')

    local ts=""
    # Try several common formats
    ts=$(date -d "$cleaned" +%s 2>/dev/null) \
        || ts=$(date -d "$(echo "$cleaned" | sed 's/^\([A-Za-z]*\) \([0-9]*\) \([A-Za-z]*\)/\2 \3/')" +%s 2>/dev/null) \
        || ts=$(date -d "$(echo "$cleaned" | awk '{print $2,$3,$4,$5}')" +%s 2>/dev/null)

    if [[ -n "$ts" && "$ts" =~ ^[0-9]+$ ]]; then
        _relative_time "$ts"
    else
        # Last resort: keep original but shortened
        echo "$cleaned" | cut -c1-16
    fi
}
export -f _date_to_relative

# --- 1. PREVIEW PANE ---
_preview() {
    export COLUMNS=120

    local raw="$1"
    local clean=$(echo "$raw" | sed -e 's/\x1b\[[0-9;]*m//g' -e 's/✔//g')
    local pkg=$(echo "$clean" | awk '{print $1}')
    local repo=$(echo "$clean" | awk '{print $2}' | tr -d '()')

    [[ -z "$pkg" ]] && return

    echo -e "\033[1;37m:: Package Details: \033[1;37m$pkg\033[0m\n"

    if pacman -Qq "$pkg" &>/dev/null; then
        # INSTALLED
        local actual_repo
        if pacman -Qm "$pkg" &>/dev/null; then actual_repo="aur"
        else actual_repo=$(expac -S '%r' "$pkg" 2>/dev/null | head -n 1); fi
        [[ -z "$actual_repo" ]] && actual_repo="sync"

        local inst_ts build_ts
        inst_ts=$(expac --timefmt='%s' -Q '%l' "$pkg" 2>/dev/null)
        build_ts=$(expac --timefmt='%s' -Q '%b' "$pkg" 2>/dev/null)
        echo -e "\033[1;34mInstalled\033[0m      : \033[0;37m$(_relative_time "$inst_ts")\033[0m"
        echo -e "\033[1;34mBuilt\033[0m          : \033[0;37m$(_relative_time "$build_ts")\033[0m\n"

        yay -Qi "$pkg" 2>/dev/null | awk -v repo="$actual_repo" '
        BEGIN { printf "\033[1;34m%-15s\033[0m : \033[1;35m%s\033[0m\n", "Repository", repo }
        /^$/ { exit }
        /^[A-Za-z].*:/ {
            idx = index($0, ":"); if (idx == 0) { skip=1; next; }
            label = substr($0, 1, idx - 1); sub(/ +$/, "", label);
            val = substr($0, idx + 1); sub(/^ +/, "", val);

            if (label ~ /^(Replaces|Packager|Built|Build Date|Installed|Install Date|Reason|Install Reason|Conflicts With|Conflicts)$/) { skip = 1; next; }
            if (label == "Depends On") label = "Dependencies"
            if (label == "Download Size" || label == "Installed Size") label = "Size"

            if (label ~ /^(Version|Description|Architecture|URL|Dependencies|Required By|Size)$/) {
                skip = 0; val_color = "\033[0;37m"
                if (label == "Version") val_color = "\033[1;33m"
                if (label == "Architecture") val_color = "\033[1;36m"
                if (label == "URL") val_color = "\033[1;32m"
                printf "\033[1;34m%-15s\033[0m : %s%s\033[0m\n", label, val_color, val
            } else { skip = 1; }
        }
        /^ +↳/ { if (!skip) { val = $0; sub(/^ +↳ */, "", val); printf "                  \033[0;37m%s\033[0m\n", val } }'

        echo -e "\n\033[1;37m:: System Integration\033[0m\n"
        echo -e "\033[1;37m🗀 Binaries:\033[0m"
        pacman -Ql "$pkg" 2>/dev/null | grep -E "/usr/bin/." | head -n 8 | awk '{print "  \033[1;32m" $2 "\033[0m"}' || echo "  (None)"
        echo -e "\n\033[0;90mTip: press Ctrl+O to open package URL in browser\033[0m"
    else
        # UNINSTALLED
        local target
        if [[ "$repo" == "aur" || -z "$repo" ]]; then target="$pkg"; else target="$repo/$pkg"; fi

        # Capture full output once so we can post-process the Updated date
        local info
        info=$(yay -Si "$target" 2>/dev/null)

        echo "$info" | awk '
        /^$/ { exit }
        /^[A-Za-z].*:/ {
            idx = index($0, ":"); if (idx == 0) { skip=1; next; }
            label = substr($0, 1, idx - 1); sub(/ +$/, "", label);
            val = substr($0, idx + 1); sub(/^ +/, "", val);

            if (label ~ /^(Replaces|Packager|Built|Build Date|Installed|Install Date|Reason|Install Reason|Conflicts With|Conflicts)$/) { skip = 1; next; }
            if (label == "Depends On") label = "Dependencies"
            if (label == "Download Size") label = "Size"
            if (label == "Out-of-date") label = "Flagged"
            if (label == "Last Modified" || label == "Last Update" || label == "Modified") {
                # Skip here – we will print a relative version ourselves
                skip = 1; next
            }

            if (label ~ /^(Repository|Version|Description|Architecture|URL|Dependencies|Required By|Size|Flagged|Votes|Popularity)$/) {
                skip = 0; val_color = "\033[0;37m"
                if (label == "Repository") val_color = "\033[1;35m"
                if (label == "Version") val_color = "\033[1;33m"
                if (label == "Architecture") val_color = "\033[1;36m"
                if (label == "URL") val_color = "\033[1;32m"
                if (label == "Flagged" && val != "No") val_color = "\033[1;31m"
                printf "\033[1;34m%-15s\033[0m : %s%s\033[0m\n", label, val_color, val
            } else { skip = 1; }
        }
        /^ +↳/ { if (!skip) { val = $0; sub(/^ +↳ */, "", val); printf "                  \033[0;37m%s\033[0m\n", val } }'

        # Extract and convert Updated / Last Modified to relative form
        local raw_updated
        raw_updated=$(echo "$info" | sed -n -E 's/^(Last Modified|Last Update|Modified)[[:space:]]*:[[:space:]]*//ip;T;q')
        if [[ -n "$raw_updated" ]]; then
            local rel
            rel=$(_date_to_relative "$raw_updated")
            echo -e "\033[1;34mUpdated\033[0m         : \033[1;35m$rel\033[0m"
        fi

        echo -e "\n\033[0;90mTip: select the package and press Ctrl+O to open its URL\033[0m"
    fi
}
export -f _preview

# --- 1.5 URL OPENER (Ctrl+O) ---
_open_url() {
    local raw="$1"
    local clean=$(echo "$raw" | sed -e 's/\x1b\[[0-9;]*m//g' -e 's/✔//g')
    local pkg=$(echo "$clean" | awk '{print $1}')
    [[ -z "$pkg" ]] && return

    local url=""
    url=$(pacman -Qi "$pkg" 2>/dev/null | sed -n 's/^URL[[:space:]]*:[[:space:]]*//ip;T;q')
    if [[ -z "$url" ]]; then
        url=$(yay -Si "$pkg" 2>/dev/null | sed -n 's/^URL[[:space:]]*:[[:space:]]*//ip;T;q')
    fi
    if [[ -z "$url" ]]; then
        url="https://aur.archlinux.org/packages/$pkg"
    fi

    # Prefer non-blocking launch
    if command -v xdg-open >/dev/null 2>&1; then
        ( setsid xdg-open "$url" >/dev/null 2>&1 & ) 2>/dev/null
    elif command -v gio >/dev/null 2>&1; then
        ( setsid gio open "$url" >/dev/null 2>&1 & ) 2>/dev/null
    else
        ( setsid sensible-browser "$url" >/dev/null 2>&1 & ) 2>/dev/null
    fi
}
export -f _open_url

# --- 2. MULTI-REPO FETCHING ---
_fetch() {
    local query=$1
    if [[ -z "$query" ]]; then
        # Default: installed packages
        expac --timefmt='%s' -Q '%n\t%m\t%v\t%r\t%l' 2>/dev/null | sort -k1 | awk -F'\t' '
        function rel(ts,   now,d) {
            if (ts == "" || ts+0 == 0) return "—"
            now = systime()
            d = now - ts
            if (d < 0) d = 0
            if (d < 60)      return "just now"
            if (d < 3600)    return int(d/60) "m ago"
            if (d < 86400)   return int(d/3600) "h ago"
            if (d < 604800)  return int(d/86400) "d ago"
            if (d < 2592000) return int(d/604800) "w ago"
            if (d < 31536000) return int(d/2592000) "mo ago"
            return int(d/31536000) "y ago"
        }
        {
            size_mib = $2 / 1048576
            if (size_mib < 1) size_str = sprintf("%.1fK", $2/1024)
            else              size_str = sprintf("%.1fM", size_mib)

            repo = $4; if (repo == "") repo = "aur"
            updated = rel($5)

            disp = sprintf("%s (%s)", $1, repo)
            # tighter columns so UPDATED always fits
            printf "\033[1;32m✔\033[0m \033[1;34m%-30.30s\033[0m \033[1;30m|\033[0m \033[38;5;208m%-8.8s\033[0m \033[1;30m|\033[0m \033[1;33m%-12.12s\033[0m \033[1;30m|\033[0m \033[0;37m%-9.9s\033[0m\n", \
                   disp, size_str, $3, updated
        }'
    else
        sleep 0.12
        yay -Ss "$query" --color=never 2>/dev/null | awk -v q="$query" '
        /^[^ ]/ {
            split($1, rp, "/"); repo = rp[1]; pkg = rp[2]; ver = $2
            is_inst = ($0 ~ /\(Installed/) ? 1 : 0

            score = 1000
            if (tolower(pkg) == tolower(q)) score -= 800
            if (is_inst) score -= 150
            if (index(tolower(pkg), tolower(q)) == 1) score -= 40
            if (repo != "aur") score -= 10

            size = "AUR"
            if (match($0, /\([0-9.]+ [KMGT]iB/)) {
                size = substr($0, RSTART+1, RLENGTH-1)
                gsub(/iB/, "", size)
            }

            age = "—"
            if (match($0, /[0-9]+ (second|minute|hour|day|week|month|year)s? ago/)) {
                age = substr($0, RSTART, RLENGTH)
                gsub(/ seconds? ago/, "s ago", age)
                gsub(/ minutes? ago/, "m ago", age)
                gsub(/ hours? ago/, "h ago", age)
                gsub(/ days? ago/, "d ago", age)
                gsub(/ weeks? ago/, "w ago", age)
                gsub(/ months? ago/, "mo ago", age)
                gsub(/ years? ago/, "y ago", age)
            }

            print score "\t" pkg "\t" repo "\t" size "\t" ver "\t" is_inst "\t" age
        }' | sort -t$'\t' -k1,1n -k2,2f | awk -F'\t' '
        {
            score=$1; pkg=$2; repo=$3; size=$4; ver=$5; is_inst=$6; age=$7

            indicator = is_inst ? "\033[1;32m✔\033[0m " : "  "
            if (is_inst)          pkg_color = "\033[1;34m"
            else if (repo=="aur") pkg_color = "\033[1;35m"
            else                  pkg_color = "\033[1;36m"

            # Real size for already-installed AUR packages
            if (is_inst && (size == "AUR" || size == "")) {
                cmd = "expac -Q \"%m\" " pkg " 2>/dev/null"
                cmd | getline bytes
                close(cmd)
                if (bytes+0 > 0) {
                    mib = bytes / 1048576
                    if (mib < 1) size = sprintf("%.1fK", bytes/1024)
                    else         size = sprintf("%.1fM", mib)
                }
            }

            disp = sprintf("%s (%s)", pkg, repo)
            printf "%s%s%-30.30s\033[0m \033[1;30m|\033[0m \033[38;5;208m%-8.8s\033[0m \033[1;30m|\033[0m \033[1;33m%-12.12s\033[0m \033[1;30m|\033[0m \033[0;37m%-9.9s\033[0m\n", \
                   indicator, pkg_color, disp, size, ver, age
        }' | head -n 80
    fi
}
export -f _fetch

# --- 3. UI ---
header_line=$(printf "  \033[1;37m%-30s \033[1;30m|\033[1;37m %-8s \033[1;30m|\033[1;37m %-12s \033[1;30m|\033[1;37m %s\033[0m" \
    "PACKAGE (REPO)" "SIZE" "VERSION" "UPDATED")

while true; do
selected=$( bash -c '_fetch ""' | fzf --multi --ansi \
  --header="$header_line" \
  --border-label=" Dusky Atlas  ·  Tab: multi  ·  Enter: act  ·  Ctrl+O: open URL  ·  mouse: click/scroll " \
  --border=rounded \
  --layout=reverse \
  --height=100% \
  --preview-window=right:48%:wrap \
  --prompt="◇ Search ❯ " \
  --pointer="▌" \
  --marker="┃" \
  --tiebreak=index \
  --no-sort \
  --preview 'bash -c "_preview {}"' \
  --bind 'change:reload(bash -c "_fetch {q}")' \
  --bind 'ctrl-o:execute-silent(bash -c "_open_url {}")' \
  --bind 'ctrl-/:toggle-preview' \
  --bind 'esc:abort' \
)

[[ -z "$selected" ]] && exit 0

# --- 4. EXECUTION ---
to_install=()
to_remove=()

while read -r line; do
    clean_line=$(echo "$line" | sed -e 's/\x1b\[[0-9;]*m//g' -e 's/✔//g' | awk '{$1=$1;print}')
    pkg=$(echo "$clean_line" | awk '{print $1}')
    repo=$(echo "$clean_line" | awk '{print $2}' | tr -d '()')
    [[ -z "$pkg" ]] && continue

    if pacman -Qq "$pkg" &>/dev/null; then
        to_remove+=("$pkg")
    else
        if [[ "$repo" == "aur" || -z "$repo" ]]; then target="$pkg"; else target="$repo/$pkg"; fi
        to_install+=("$target")
    fi
done <<< "$selected"

clear

if [[ ${#to_remove[@]} -gt 0 ]]; then
    echo -e "\033[1;35m:: Triggering uninstaller for:\033[0m ${to_remove[*]}"
    if [[ -x "$HOME/custom-scripts/uninstaller.sh" ]]; then
        "$HOME/custom-scripts/uninstaller.sh" "${to_remove[@]}"
    else
        echo -e "\033[1;33m(uninstaller.sh not found – falling back to yay -Rns)\033[0m"
        yay -Rns "${to_remove[@]}"
    fi
fi

if [[ ${#to_install[@]} -gt 0 ]]; then
    echo -e "\n\033[1;36m:: Installing packages via yay:\033[0m ${to_install[*]}"
    yay -S "${to_install[@]}"
fi

echo -e "\n\033[1;32mPress any key to go back...\033[0m"
read -n 1 -s -r
done

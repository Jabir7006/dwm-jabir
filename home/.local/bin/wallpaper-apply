#!/bin/sh
# wallpaper-apply — the ONE place a wallpaper gets applied (picture + theme).
#
# Shared by wallpaper-picker.sh (rofi grid) and wallpaper-carousel (filmstrip),
# so both stay in sync with the dynamic-theme pipeline.
#
#   wallpaper-apply ~/Pictures/backgrounds/foo.jpg
#
# Apply and save the picture first. Palette generation must never prevent a
# wallpaper change or repaint an earlier selection after a later one.

file="${1:-}"
[ -n "${file:-}" ] || { echo "wallpaper-apply: usage: wallpaper-apply <image>" >&2; exit 1; }
[ -f "$file" ] && [ -r "$file" ] || { echo "wallpaper-apply: not readable: $file" >&2; exit 1; }
file="$(realpath -- "$file")" || exit 1

notify() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send --urgency="$1" "Wallpaper" "$2" 9>&- 2>/dev/null &
    fi
}

umask 077
cache="${XDG_CACHE_HOME:-$HOME/.cache}/wallpaper-picker"
mkdir -p "$cache" || exit 1
# Serialize picture/palette updates, including rapid selections from both UIs.
exec 9>>"$cache/apply.lock" || exit 1
flock -w 45 9 || { echo "wallpaper-apply: another update is still running" >&2; exit 1; }
if ! feh --bg-fill "$file"; then
    echo "wallpaper-apply: failed to set $file" >&2
    notify critical "Could not apply or save the selected image."
    exit 1
fi

active="$(awk -F'"' '/^\[active\]/{f=1} f&&/theme =/{print $2; exit}' \
    "${XDG_CONFIG_HOME:-$HOME/.config}/dwm-titus/themes.toml" 2>/dev/null)"

if [ -x "$HOME/.local/bin/theme-set-dynamic" ]; then
    set -- --no-wallpaper "$file"
    [ "$active" = dynamic ] || set -- --stage-only "$@"
    if ! timeout 30 "$HOME/.local/bin/theme-set-dynamic" "$@" >"$cache/apply.log" 2>&1; then
        echo "wallpaper-apply: image applied; palette update failed (see $cache/apply.log)" >&2
        notify normal "Image applied. Palette update failed; see $cache/apply.log."
        exit 0
    fi
elif [ "$active" = dynamic ]; then
    echo "wallpaper-apply: image applied; theme-set-dynamic is unavailable" >&2
    notify normal "Image applied. Dynamic theme helper is unavailable."
    exit 0
fi

notify normal "$(basename "$file")"
exit 0

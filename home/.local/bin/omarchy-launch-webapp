#!/bin/bash
# omarchy-launch-webapp (DWM/X11 version)
# Usage: omarchy-launch-webapp <url> [--class=<wm-class>]

set -e

URL="$1"
shift || true

CLASS=""
for arg in "$@"; do
  case $arg in
    --class=*) CLASS="${arg#--class=}" ;;
  esac
done

if [[ -z $CLASS ]]; then
  CLASS="WebApp-$(basename "$URL" | tr -c 'a-zA-Z0-9' '-')"
fi

browser=$(xdg-settings get default-web-browser 2>/dev/null)
case $browser in
  google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | chromium*) ;;
  *) browser="chromium.desktop" ;;
esac

exec_cmd=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' {~/.local,/usr}/share/applications/"$browser" 2>/dev/null | head -1)
[[ -z $exec_cmd ]] && exec_cmd="chromium"

exec "$exec_cmd" --app="$URL" --class="$CLASS"

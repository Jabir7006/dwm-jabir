#!/bin/bash

AP_IF="ap0"
AP_IP="10.42.0.1/24"
HOSTAPD_CONF="/etc/hostapd/localsend.conf"
PIDFILE="/run/localsend-dnsmasq.pid"

if pgrep -f "hostapd.*$HOSTAPD_CONF" >/dev/null 2>&1; then
    pkill -f "hostapd.*$HOSTAPD_CONF"
    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")" 2>/dev/null || true
        rm -f "$PIDFILE"
    fi
    echo "LocalSend AP: OFF"
    exit 0
fi

# Detect the channel currently used by the main Wi-Fi
FREQ=$(iw dev wlo1 link | awk '/freq:/ {printf "%d\n", $2; exit}')

case "$FREQ" in
    2412) CHANNEL=1; HT40="[HT40+]" ;;
    2417) CHANNEL=2; HT40="[HT40+]" ;;
    2422) CHANNEL=3; HT40="[HT40+]" ;;
    2427) CHANNEL=4; HT40="[HT40+]" ;;
    2432) CHANNEL=5; HT40="[HT40+]" ;;
    2437) CHANNEL=6; HT40="[HT40+]" ;;
    2442) CHANNEL=7; HT40="[HT40+]" ;;
    2447) CHANNEL=8; HT40="[HT40-]" ;;
    2452) CHANNEL=9; HT40="[HT40-]" ;;
    2457) CHANNEL=10; HT40="[HT40-]" ;;
    2462) CHANNEL=11; HT40="[HT40-]" ;;
    2467) CHANNEL=12; HT40="[HT40-]" ;;
    2472) CHANNEL=13; HT40="[HT40-]" ;;
    *)
        echo "LocalSend AP: could not detect Wi-Fi channel"
        exit 1
        ;;
esac

# Update hostapd to match the main Wi-Fi channel
sed -i "s/^channel=.*/channel=$CHANNEL/" "$HOSTAPD_CONF"
if iw dev wlo1 link | grep -q '40MHz'; then
    sed -i "s/^ht_capab=.*/ht_capab=$HT40[SHORT-GI-20][SHORT-GI-40]/" "$HOSTAPD_CONF"
else
    sed -i "s/^ht_capab=.*/ht_capab=[SHORT-GI-20][SHORT-GI-40]/" "$HOSTAPD_CONF"
fi

if ! ip link show "$AP_IF" >/dev/null 2>&1; then
    iw dev wlo1 interface add "$AP_IF" type __ap
fi

ip addr add "$AP_IP" dev "$AP_IF" 2>/dev/null || true
ip link set "$AP_IF" up

hostapd "$HOSTAPD_CONF" >/dev/null 2>&1 &
sleep 2

if ! pgrep -f "hostapd.*$HOSTAPD_CONF" >/dev/null 2>&1; then
    echo "LocalSend AP: hostapd failed on channel $CHANNEL"
    exit 1
fi

dnsmasq \
    --interface="$AP_IF" \
    --bind-interfaces \
    --dhcp-range=10.42.0.10,10.42.0.100,255.255.255.0,12h \
    --no-resolv \
    --no-hosts \
    --pid-file="$PIDFILE" \
    >/dev/null 2>&1 &

echo "LocalSend AP: ON (channel $CHANNEL)"

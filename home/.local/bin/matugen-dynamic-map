#!/usr/bin/env python3
"""matugen-dynamic-map — convert matugen Material You JSON into a
dwm-titus [theme.dynamic] TOML block (printed to stdout).

Usage:
    matugen image wallpaper.jpg --json hex | matugen-dynamic-map --wallpaper wallpaper.jpg
    matugen-dynamic-map --from-json scheme.json --wallpaper wallpaper.jpg

Mapping principles:
  * Text/background pairs use Material's own on_* roles, so WCAG contrast
    is inherited from the M3 spec instead of guessed.
  * The desktop accent uses Material's primary role for the selected mode.
  * ANSI hues are assigned greedily by closest-hue from the M3 accent pool
    (error is pinned to red, as M3 intends), keeping terminal colors true
    to the wallpaper instead of forcing rainbow slots.
  * Bright ANSI 9-15 are lifted variants of 1-7 (guaranteed readable).
  * DWM/polybar keys reuse surface/outline roles, mirroring how the static
    themes map their palettes.

Exit non-zero with an error message (and no output) on any failure, so
callers never write a half-generated theme.
"""
import argparse
import colorsys
import json
import sys


def lum(hex_color):
    h = hex_color.lstrip("#")
    r, g, b = (int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))

    def f(c):
        return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4

    return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b)


def contrast(a, b):
    la, lb = lum(a), lum(b)
    return (max(la, lb) + 0.05) / (min(la, lb) + 0.05)


def lift(hex_color, amt=0.25):
    h = hex_color.lstrip("#")
    c = [int(h[i:i + 2], 16) for i in (0, 2, 4)]
    return "#" + "".join(f"{round(v + (255 - v) * amt):02X}" for v in c)


def shade(hex_color, amt=0.25):
    """Darken toward black — the light-mode counterpart of lift()."""
    h = hex_color.lstrip("#")
    c = [int(h[i:i + 2], 16) for i in (0, 2, 4)]
    return "#" + "".join(f"{round(v * (1 - amt)):02X}" for v in c)


def hue_deg(hex_color):
    h = hex_color.lstrip("#")
    r, g, b = (int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))
    return colorsys.rgb_to_hsv(r, g, b)[0] * 360


def sat_val(hex_color):
    h = hex_color.lstrip("#")
    r, g, b = (int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))
    _, s, v = colorsys.rgb_to_hsv(r, g, b)
    return s * 100, v * 100


def synth(hue, sat, val):
    """Build a colour from HSV, so ANSI slots can be given real, separated hues."""
    r, g, b = colorsys.hsv_to_rgb((hue % 360) / 360, sat / 100, val / 100)
    return "#%02X%02X%02X" % (round(r * 255), round(g * 255), round(b * 255))


def wallpaper_luminance(wallpaper):
    try:
        from PIL import Image, ImageStat

        with Image.open(wallpaper) as im:
            im = im.convert("L").resize((64, 64))
            return ImageStat.Stat(im).mean[0] / 255
    except Exception as exc:
        print(f"matugen-dynamic-map: cannot read wallpaper: {exc}", file=sys.stderr)
        sys.exit(1)


def pick_scheme(data, wallpaper, forced):
    """Return (mode, roles). Handles three matugen JSON shapes:
    nested {colors:{dark,light}}, flat {colors:{roles}} (with -m dark|light,
    mode also echoed in top-level "mode"), and bare {roles} dicts."""
    colors = data.get("colors")
    if isinstance(colors, dict) and "dark" in colors and "light" in colors:
        mean = wallpaper_luminance(wallpaper)
        return ("dark", colors["dark"]) if mean < 0.45 else ("light", colors["light"])
    if isinstance(colors, dict) and "background" in colors:
        mode = (forced or data.get("mode") or "dark").lower()
        if mode not in ("dark", "light"):
            print(f"matugen-dynamic-map: bad scheme '{mode}'", file=sys.stderr)
            sys.exit(1)
        return mode, colors
    if "background" in data:
        mode = (forced or "dark").lower()
        if mode not in ("dark", "light"):
            print(f"matugen-dynamic-map: bad scheme '{mode}'", file=sys.stderr)
            sys.exit(1)
        return mode, data
    print("matugen-dynamic-map: unrecognized matugen JSON shape", file=sys.stderr)
    sys.exit(1)


def build_ansi(scheme, bg, dark):
    """Return dict color0..color15 from M3 roles (all values '#RRGGBB')."""
    for key in ("error", "outline", "outline_variant", "on_surface",
                "on_background", "surface_variant"):
        if key not in scheme:
            print(f"matugen-dynamic-map: scheme missing role '{key}'", file=sys.stderr)
            sys.exit(1)
    ansi = {}
    ansi[0] = scheme["outline_variant"]
    ansi[1] = scheme["error"]
    ansi[7] = scheme["on_surface"]
    ansi[8] = scheme["outline"]
    ansi[15] = scheme["on_background"]
    # Chromatic slots (green/yellow/blue/magenta/cyan). Picking the nearest of
    # the six M3 roles does not work: an M3 scheme keeps every role within ~75
    # degrees of the source hue, so a magenta wallpaper produced magenta
    # "green" and magenta "cyan" (measured slots: 28/26/337/340/340 deg against
    # targets 120/60/240/300/180) — which is why it looked yellow. Those hues
    # are scheme artefacts, not measurements of the picture, so synthesise the
    # five slots on a classic ANSI wheel: anchored at the scheme's red, tinted
    # with the palette's own saturation so the rainbow still matches the theme.
    targets = {2: 120.0, 3: 60.0, 4: 240.0, 5: 300.0, 6: 180.0}
    pool = [c for k, c in (
        ("primary", scheme.get("primary")),
        ("secondary", scheme.get("secondary")),
        ("tertiary", scheme.get("tertiary")),
        ("primary_container", scheme.get("primary_container")),
        ("secondary_container", scheme.get("secondary_container")),
        ("tertiary_container", scheme.get("tertiary_container")),
    ) if c]
    anchor = hue_deg(scheme["error"])
    sats = sorted(sat_val(c)[0] for c in pool)
    sat = min(75.0, max(40.0, sats[len(sats) // 2])) if sats else 45.0
    val = 85.0 if dark else 45.0
    for slot, target in sorted(targets.items()):
        ansi[slot] = synth(anchor + target, sat, val)
    # Brights: lifted normals (always readable on the background).
    for slot in range(9, 15):
        ansi[slot] = lift(ansi[slot - 8], 0.25)
    # Guard: every ANSI color must stay legible on the background, even
    # for near-monochrome wallpapers whose M3 roles cluster in one hue.
    floor = 2.0
    for slot in list(ansi):
        if slot in (7, 15):
            continue
        if contrast(ansi[slot], bg) < floor:
            ansi[slot] = lift(ansi[slot], 0.45) if dark else shade(ansi[slot], 0.45)
    return {f"term_color{i}": v.upper() for i, v in ansi.items()}


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--wallpaper", required=True)
    ap.add_argument("--from-json", default=None)
    ap.add_argument("--scheme", default=None,
                    help="dark|light: scheme mode when JSON is a flat single scheme")
    args = ap.parse_args()

    try:
        raw = open(args.from_json).read() if args.from_json else sys.stdin.read()
        data = json.loads(raw)
    except Exception as exc:
        print(f"matugen-dynamic-map: invalid JSON input: {exc}", file=sys.stderr)
        sys.exit(1)

    mode, s = pick_scheme(data, args.wallpaper, args.scheme)
    # matugen 4.x roles are {dark:{color},default:{color},light:{color}} maps;
    # flatten to plain hex for the chosen mode (plain strings pass through).
    flat = {}
    for k, v in s.items():
        if isinstance(v, dict):
            c = v.get(mode, {}).get("color", v.get("default", {}).get("color"))
            if not c:
                print(f"matugen-dynamic-map: role '{k}' has no color", file=sys.stderr)
                sys.exit(1)
            flat[k] = c
        else:
            flat[k] = v
    s = flat
    s = {k: (v.upper() if isinstance(v, str) and v.startswith("#") else v)
         for k, v in s.items()}
    dark = mode == "dark"
    get = lambda k, fb: s.get(k, fb)  # noqa: E731

    bg = s["background"].upper()
    fg = s["on_background"].upper()
    accent = s["primary"].upper()
    surface = s.get("surface_variant", s["surface"]).upper()
    # Keep the established neutral unfocused border. The wallpaper accent is
    # intentionally reserved for the selected/focused border.
    border = "#3B4252"
    muted = s.get("outline", s["secondary"]).upper()

    if contrast(fg, bg) < 4.5:
        print(f"matugen-dynamic-map: fg/bg contrast too low "
              f"({contrast(fg, bg):.1f}): {fg} on {bg}", file=sys.stderr)
        sys.exit(1)
    if contrast(accent, bg) < 3.0:
        print(f"matugen-dynamic-map: WARNING accent/bg contrast low "
              f"({contrast(accent, bg):.1f})", file=sys.stderr)

    ansi = build_ansi(s, bg, dark)
    t = {}
    t["normfgcolor"] = s["on_surface"]
    t["normbgcolor"] = bg
    t["normbordercolor"] = border
    t["selfgcolor"] = fg
    t["selbgcolor"] = surface
    t["selbordercolor"] = accent
    t["term_bg"] = bg
    t["term_fg"] = fg
    t["term_cursor"] = accent
    t.update(ansi)
    t["ghostty_theme"] = "custom"
    t["rofi_theme"] = "sidetab-custom"
    t["dark_mode"] = "true" if dark else "false"
    t["polybar_bg"] = bg
    t["polybar_fg"] = fg
    t["polybar_bg_alt"] = surface
    t["polybar_fg_alt"] = muted
    t["polybar_accent"] = accent
    t["polybar_urgent"] = s["error"]
    t["browser_frame"] = bg
    t["gtk_muted"] = muted
    # Sidebar: M3's raised surface (carries the wallpaper hue while staying
    # dark). Selection: M3's designed container pairing (deep harmonious
    # fill + its matching text) instead of a neon full-accent slab.
    # Missing roles are omitted so theme-apply falls back to accent/bg.
    if "surface_container" in s:
        t["gtk_bg"] = s["surface_container"]
    if "primary_container" in s and "on_primary_container" in s:
        t["select_bg"] = s["primary_container"]
        t["select_fg"] = s["on_primary_container"]

    order = (["normfgcolor", "normbgcolor", "normbordercolor",
              "selfgcolor", "selbgcolor", "selbordercolor", "",
              "term_bg", "term_fg", "term_cursor"]
             + [f"term_color{i}" for i in range(16)] + ["",
              "ghostty_theme", "rofi_theme", "dark_mode", "",
               "polybar_bg", "polybar_fg", "polybar_bg_alt",
               "polybar_fg_alt", "polybar_accent", "polybar_urgent",
               "browser_frame", "gtk_muted",
               "gtk_bg", "select_bg", "select_fg"])
    print("[theme.dynamic]")
    print("# generated from wallpaper — managed by theme-set-dynamic, do not edit")
    for key in order:
        if not key:
            print()
            continue
        if key not in t:
            continue
        val = t[key]
        if key == "dark_mode":
            print(f"{key:<16}= {val}")
        else:
            print(f'{key:<16}= "{val}"')


if __name__ == "__main__":
    main()
